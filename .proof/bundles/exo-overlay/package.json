{
  "name": "@exocortex/exo-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The ?exo_overlay sandbox: serves candidate bundles from /tmp/exo-overlay, promotes them transactionally into the canonical graph, and keeps candidates mounted through canonical HMR.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "exocortex": {
    "manager": "pm_exo_overlay",
    "zones": []
  }
}
